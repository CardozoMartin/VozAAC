# ---------------------------------------------------------------
# Copiá este archivo a .env y ajustá los valores.
# El .env real NO se commitea (ver .gitignore).
# ---------------------------------------------------------------

# --- Base de datos (coincide con docker-compose.yml) ---
POSTGRES_USER=vozaac
POSTGRES_PASSWORD=vozaac_dev
POSTGRES_DB=vozaac
POSTGRES_PORT=5442
POSTGRES_TEST_PORT=5443

DB_HOST=localhost
DB_PORT=5442
DB_USER=vozaac
DB_PASSWORD=vozaac_dev
DB_NAME=vozaac

# --- API ---
NODE_ENV=development
API_PORT=3010

# --- Autenticación (Módulo 2) ---
# En producción usar un secreto largo y aleatorio.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# --- Uploads (Módulo 4) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- Integración ARASAAC (Módulo 4) ---
ARASAAC_API_URL=https://api.arasaac.org/api
