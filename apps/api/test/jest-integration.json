{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-test-env.ts"],
  "moduleNameMapper": {
    "^@vozaac/shared$": "<rootDir>/../../packages/shared/src/index.ts",
    "^src/(.*)$": "<rootDir>/src/$1"
  }
}
